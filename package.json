{
  "name": "image-file-transfer",
  "version": "1.0.0",
  "private": true,
  "description": "Static browser app for transferring files through animated QR frames.",
  "bin": "exe-server.js",
  "scripts": {
    "build": "npm run check",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/qr-file-transfer.exe",
    "build:vendor": "browserify node_modules/qrcode/lib/browser.js --standalone QRCode -o public/vendor/qrcode.js",
    "check": "node --check public/app.js"
  },
  "devDependencies": {
    "browserify": "^17.0.1",
    "jsqr": "^1.4.0",
    "pkg": "^5.8.1",
    "qrcode": "^1.5.4"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ]
  }
}
